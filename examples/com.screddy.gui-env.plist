<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.screddy.gui-env</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/screddy/projects/SRC/claude-code-harness/scripts/set-gui-env.sh</string>
    </array>
    <!-- Key names only. set-gui-env.sh reads the values from ~/projects/.env
         (or ~/.claude.json for NEBOS_OS_BEARER_TOKEN) and never writes them here. -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>GUI_ENV_KEYS</key>
        <string>CMEM_PRO_TOKEN NEBOS_OS_BEARER_TOKEN</string>
    </dict>
    <key>RunAtLoad</key>
    <true/>
    <!-- Hourly refresh so a change to Ollama's parallel-decode slots reaches the
         GUI domain without a logout. router-gui-env.sh polled this every 60s;
         a value that changes when a plist is hand-edited does not need that. -->
    <key>StartInterval</key>
    <integer>3600</integer>
    <key>StandardOutPath</key>
    <string>/Users/screddy/.local/state/gui-env.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/screddy/.local/state/gui-env.log</string>
</dict>
</plist>
