{
  "$version": 4,
  "security": { "auth": { "selectedType": "openai" } },
  "model": {
    "name": "${QWEN_SESSION_MODEL}",
    "maxToolCallsPerTurn": 12,
    "skipLoopDetection": false
  },
  "modelProviders": {
    "openai": [{
      "id": "${QWEN_SESSION_MODEL}",
      "name": "${QWEN_SESSION_MODEL} (Ollama)",
      "envKey": "OPENAI_API_KEY",
      "baseUrl": "${QWEN_LOCAL_BASE_URL}",
      "generationConfig": {
        "contextWindowSize": 32768,
        "timeout": 300000,
        "streamIdleTimeoutMs": 120000,
        "maxRetries": 1,
        "samplingParams": { "temperature": 0.2, "max_tokens": 4096 }
      }
    }]
  },
  "context": {
    "fileName": ["AGENTS.md", "QWEN.md"],
    "autoCompactThreshold": 0.8
  },
  "skills": { "disabledLevels": ["user", "bundled"] },
  "memory": { "enableManagedAutoMemory": false, "enableManagedAutoDream": false },
  "permissions": { "deny": ["notebook_edit"] },
  "tools": {
    "approvalMode": "default",
    "eager": ["read_file", "grep_search", "glob", "edit", "write_file", "run_shell_command"],
    "toolSearch": { "threshold": 0 }
  },
  "telemetry": { "enabled": false, "logPrompts": false },
  "privacy": { "usageStatisticsEnabled": false }
}
